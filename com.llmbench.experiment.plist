<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <!-- 서비스 식별자 (기존 scheduler와 겹치지 않게 다른 이름 사용) -->
    <key>Label</key>
    <string>com.llmbench.experiment</string>

    <!-- 실행할 명령어
         ⚠️  아래 경로를 실제 환경에 맞게 확인하세요
         - python 경로 확인: conda activate llm_router && which python
         - experiment_api.py 경로 확인: 실제 프로젝트 폴더 경로로 수정
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/nojaegyeong/anaconda3/envs/llm_router/bin/python</string>
        <string>/Users/nojaegyeong/Documents/GitHub/llm_trafic_router/experiment_api.py</string>
    </array>

    <!-- 작업 디렉토리 (experiment_api.py가 있는 폴더) -->
    <key>WorkingDirectory</key>
    <string>/Users/nojaegyeong/Documents/GitHub/llm_trafic_router</string>

    <!-- 크래시/네트워크 오류로 종료 시 자동 재시작 -->
    <key>KeepAlive</key>
    <true/>

    <!-- 재시작 전 대기 시간 (초)
         너무 짧으면 API 오류 루프 위험 → 60초 권장 -->
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <!-- 로그인 시 자동 시작 -->
    <key>RunAtLoad</key>
    <true/>

    <!-- 환경 변수: .env 파일이 있어도 명시적으로 지정하면 안전 -->
    <!-- <key>EnvironmentVariables</key>
    <dict>
        <key>OPENAI_API_KEY</key>
        <string>sk-...</string>
        <key>ANTHROPIC_API_KEY</key>
        <string>sk-ant-...</string>
        <key>GOOGLE_API_KEY</key>
        <string>...</string>
        <key>DASHSCOPE_API_KEY</key>
        <string>...</string>
    </dict> -->

    <!-- stdout / stderr 로그 경로 -->
    <key>StandardOutPath</key>
    <string>/Users/nojaegyeong/Documents/GitHub/llm_trafic_router/launchd_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/nojaegyeong/Documents/GitHub/llm_trafic_router/launchd_stderr.log</string>

</dict>
</plist>
